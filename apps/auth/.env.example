# This service also reads two shared env files not listed here — copy them
# too, or the auth service will fail to boot (see CFG-003):
#   libs/common/src/database/.env  (from libs/common/src/database/.env.example)
#   libs/common/src/jwt/.env       (from libs/common/src/jwt/.env.example)

RABBIT_MQ_URI=amqp://rabbitmq:5672
RABBIT_MQ_AUTH_QUEUE=auth
RABBIT_MQ_LOGGER_QUEUE=logger

ERROR_LOG_MIN_SEVERITY=warn
