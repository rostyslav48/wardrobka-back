# This service also reads a shared env file not listed here — copy it too, or
# the ai-assistant service will fail to boot (see CFG-003):
#   libs/common/src/database/.env  (from libs/common/src/database/.env.example)

RABBIT_MQ_URI=amqp://rabbitmq:5672
RABBIT_MQ_AI_ASSISTANT_QUEUE=ai-assistant
RABBIT_MQ_WARDROBE_QUEUE=wardrobe
RABBIT_MQ_MEDIA_STORAGE_QUEUE=media-storage

PROTECTED_DATA_SECRET=change-me
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
AI_HISTORY_MESSAGE_LIMIT=10
# Retrieval-loop guardrails: max model<->tool rounds, max tool calls per
# message, max rows any one tool may return, and how long a city's forecast is
# reused before OpenWeatherMap is hit again.
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS=8
AI_TOOL_ROW_LIMIT=100
AI_WEATHER_CACHE_TTL_MS=600000
# Deadline for the image-analyzer's Gemini call (ms) — a hung call aborts and
# reports a timeout instead of holding the synchronous analyze request open.
GEMINI_ANALYZE_TIMEOUT_MS=15000
AI_ASSISTANT_WEBHOOK_URL=https://example.com/wardrobe-ai/webhook
AI_ASSISTANT_WEBHOOK_AUTH_HEADER=X-Wardrobe-AI-Key
OPENWEATHERMAP_API_KEY=apikey
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INTERVAL_MS=60000

