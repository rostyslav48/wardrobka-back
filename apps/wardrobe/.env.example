# This service also reads a shared env file not listed here — copy it too, or
# the wardrobe service will fail to boot (see CFG-003):
#   libs/common/src/database/.env  (from libs/common/src/database/.env.example)

RABBIT_MQ_URI=amqp://rabbitmq:5672
RABBIT_MQ_WARDROBE_QUEUE=wardrobe
RABBIT_MQ_MEDIA_STORAGE_QUEUE=media-storage

USER_IMAGES_FOLDER_PATH=user-images
