# This service also reads a shared env file not listed here — copy it too, or
# the gateway will fail to boot (see CFG-003):
#   libs/common/src/jwt/.env  (from libs/common/src/jwt/.env.example)

RABBIT_MQ_URI=amqp://rabbitmq:5672

RABBIT_MQ_WARDROBE_QUEUE=wardrobe
RABBIT_MQ_AUTH_QUEUE=auth
RABBIT_MQ_AI_ASSISTANT_QUEUE=ai-assistant
RABBIT_MQ_LOGGER_QUEUE=logger

ERROR_LOG_MIN_SEVERITY=warn

PORT=3000
CORS_ORIGINS=http://localhost:8081
